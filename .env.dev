# Frontend Configuration
FRONTEND_PORT="3000"                         # Port for the frontend application
VITE_FRONTEND_URL="http://localhost:3000"    # Frontend URL for Vite development
VITE_API_URL="http://localhost:8000/v1"      # API base URL for frontend integration

# Backend Configuration
ADMIN_PATH="admin/"                          # Admin path for the Django admin panel
BACKEND_PORT="8000"                          # Port for the backend application
DJANGO_ALLOWED_HOSTS="localhost *"           # Allowed hosts for Django (use '*' with caution in production)
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost" # CSRF trusted origins for secure requests

# Environment-Specific Setting
ENVIRONMENT="development"                    # Options: development, staging, production

# Database Configuration
DATABASE_PORT="5432"                         # Database port (default for PostgreSQL)
DATABASE_HOST="db"                           # Hostname for the database
DATABASE_NAME="activist"                     # Name of the database
DATABASE_USER="postgres"                     # Database user
DATABASE_PASSWORD="postgres"                 # Use a secure password (store it securely)
DATABASE_MAX_CONNECTIONS="20"                # Maximum database connections (optional for connection pooling)
DATABASE_MIN_CONNECTIONS="5"                 # Minimum database connections (optional for pooling)

# Security Settings
SECRET_KEY="replace_with_secure_key"         # Django secret key (use environment variables for production)
DEBUG="1"                                    # Debug mode: 1 for development, 0 for production

# Email Configuration
ACTIVIST_EMAIL="noreply@activist.org"        # Default email sender address
EMAIL_HOST="smtp.activist.org"               # SMTP server hostname
EMAIL_PORT="587"                             # SMTP server port
EMAIL_HOST_USER="activist@activist.org"      # Email username
EMAIL_HOST_PASSWORD="activist123!?"          # Email password (store securely)
EMAIL_USE_TLS="True"                         # Use TLS for secure email delivery
EMAIL_FALLBACK="fallback@activist.org"       # Fallback email (optional)
DEFAULT_FROM_EMAIL="Activist <noreply@activist.org>" # Default sender email

# Logging Configuration
LOG_LEVEL="INFO"                             # Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE_PATH="/var/log/activist_app.log"    # Log file path (ensure writable permissions)

# Caching (Optional)
CACHE_BACKEND="redis"                        # Backend for caching (e.g., redis, memcached)
CACHE_HOST="redis_host"                      # Hostname for cache server
CACHE_PORT="6379"                            # Port for cache server

# Analytics (Optional)
GOOGLE_ANALYTICS_ID="UA-XXXXX-Y"             # Google Analytics tracking ID (if applicable)

# Notes 
# 1. Avoid hardcoding sensitive information in this file for production.
# 2. Use environment variables or secrets management tools like AWS Secrets Manager, Vault, or dotenv for secure storage.
# 3. Ensure the `SECRET_KEY` is unique and follows security best practices.
# 4. Use strong passwords for `DATABASE_PASSWORD` and `EMAIL_HOST_PASSWORD`.

